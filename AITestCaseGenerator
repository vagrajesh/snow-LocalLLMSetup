var AITestCaseGenerator = Class.create();
AITestCaseGenerator.prototype = {
    
    /**
     * Initialize the generator with configuration from system properties
     */
    initialize: function() {
        // Provider selection
        this.PROVIDER = gs.getProperty('ai.provider', 'cloud'); // 'cloud' or 'local'
        
        // Cloud Provider Configuration (Azure OpenAI or other OpenAI-compatible cloud API)
        this.CLOUD_ENDPOINT = gs.getProperty('ai.cloud.endpoint');
        this.CLOUD_API_KEY = gs.getProperty('ai.cloud.api.key');
        this.CLOUD_DEPLOYMENT_NAME = gs.getProperty('ai.cloud.deployment.name');
        this.CLOUD_API_VERSION = gs.getProperty('ai.cloud.api.version', '2024-02-15-preview');
        
        // Local Provider Configuration
        this.LOCAL_ENDPOINT = gs.getProperty('ai.local.endpoint');
        this.LOCAL_MODEL_NAME = gs.getProperty('ai.local.model.name');
        this.LOCAL_MID_SERVER = gs.getProperty('ai.local.mid.server', '');
        this.LOCAL_API_KEY = gs.getProperty('ai.local.api.key', '');
        
        // Shared Configuration
        this.TIMEOUT = parseInt(gs.getProperty('ai.timeout', '120000'));
        this.TEST_CASE_COUNT = parseInt(gs.getProperty('ai.test.case.count', '5'));
        this.MAX_RETRIES = parseInt(gs.getProperty('ai.max.retries', '3'));
        
        // Logging prefix
        this.LOG_PREFIX = 'AITestCaseGenerator';
        
        // Validate configuration
        this._validateConfiguration();
    },
    
    /**
     * Validate that all required configuration is present based on active provider
     * @returns {Object} - {valid: boolean, errors: []}
     */
    _validateConfiguration: function() {
        var errors = [];
        
        if (this.PROVIDER === 'cloud') {
            if (!this.CLOUD_ENDPOINT) errors.push('Cloud endpoint not configured (ai.cloud.endpoint)');
            if (!this.CLOUD_API_KEY) errors.push('Cloud API key not configured (ai.cloud.api.key)');
            if (!this.CLOUD_DEPLOYMENT_NAME) errors.push('Cloud deployment name not configured (ai.cloud.deployment.name)');
            
        } else if (this.PROVIDER === 'local') {
            if (!this.LOCAL_ENDPOINT) errors.push('Local LLM endpoint not configured (ai.local.endpoint)');
            if (!this.LOCAL_MODEL_NAME) errors.push('Local LLM model name not configured (ai.local.model.name)');
            if (!this.LOCAL_API_KEY) {
                gs.warn(this.LOG_PREFIX + ': No ai.local.api.key set — proceeding without auth header (OK if your server doesn\'t require one)');
            }
            
        } else {
            errors.push('Invalid ai.provider value: "' + this.PROVIDER + '". Must be "cloud" or "local"');
        }
        
        if (errors.length > 0) {
            gs.error(this.LOG_PREFIX + ': Configuration errors: ' + errors.join(', '));
            return { valid: false, errors: errors };
        }
        
        gs.debug(this.LOG_PREFIX + ': Configuration validated successfully (provider: ' + this.PROVIDER + ')');
        return { valid: true, errors: [] };
    },
    
    /**
     * Main entry point - Generate test cases for a user story
     * @param {String} storyId - User story sys_id
     * @returns {Object} - {success, message, totalGenerated, results}
     */
    generateTestCases: function(storyId) {
        var startTime = new Date().getTime();
        
        try {
            gs.info(this.LOG_PREFIX + ': Starting test case generation for story: ' + storyId + 
                    ' using provider: ' + this.PROVIDER);
            
            var configValidation = this._validateConfiguration();
            if (!configValidation.valid) {
                return this._buildFailureResult('Configuration error: ' + configValidation.errors.join(', '));
            }
            
            var storyResult = this._getUserStory(storyId);
            if (!storyResult.success) {
                return this._buildFailureResult(storyResult.message);
            }
            
            var story = storyResult.data;
            
            var validator = new AITestGenerationValidator();
            var validation = validator.validateStory(story);
            
            if (!validation.valid) {
                return this._buildFailureResult('Story validation failed: ' + validation.errors.join(', '));
            }
            
            var prompts = this._buildPrompt(story);
            if (!prompts) {
                return this._buildFailureResult('Failed to build AI prompt');
            }
            
            // Route to correct provider
            gs.info(this.LOG_PREFIX + ': Calling ' + this.PROVIDER + ' LLM API...');
            var apiResult = (this.PROVIDER === 'local') ? 
                this._callLocalLLM(prompts) : 
                this._callCloudLLM(prompts);
            
            if (!apiResult.success) {
                var duration1 = Math.round((new Date().getTime() - startTime) / 1000);
                var failResult = this._buildFailureResult(apiResult.message);
                this._logGeneration(storyId, failResult, duration1, null);
                return failResult;
            }
            
            gs.info(this.LOG_PREFIX + ': Parsing AI response...');
            var aiData = this._parseAIResponse(apiResult.data);
            
            if (!aiData || !aiData.test_cases) {
                var duration2 = Math.round((new Date().getTime() - startTime) / 1000);
                var parseFailResult = this._buildFailureResult('Failed to parse AI response');
                this._logGeneration(storyId, parseFailResult, duration2, apiResult.rawResponse);
                return parseFailResult;
            }
            
            gs.info(this.LOG_PREFIX + ': Creating test cases in ServiceNow...');
            var createResult = this._createTestCases(aiData, storyId);
            
            var duration = Math.round((new Date().getTime() - startTime) / 1000);
            this._logGeneration(storyId, createResult, duration, apiResult.rawResponse);
            
            var finalResult = {
                success: createResult.success,
                message: createResult.success ? 
                    'Successfully generated ' + createResult.successCount + ' of ' + 
                    (createResult.successCount + createResult.failureCount) + ' test cases (via ' + this.PROVIDER + ')' :
                    'Failed to generate test cases: ' + createResult.message,
                totalGenerated: createResult.successCount,
                successCount: createResult.successCount,
                failureCount: createResult.failureCount,
                createdTests: createResult.createdTests,
                duration: duration,
                storyId: storyId,
                provider: this.PROVIDER
            };
            
            gs.info(this.LOG_PREFIX + ': Generation complete in ' + duration + ' seconds using ' + this.PROVIDER);
            return finalResult;
            
        } catch (e) {
            gs.error(this.LOG_PREFIX + '.generateTestCases: ' + e);
            var duration3 = Math.round((new Date().getTime() - startTime) / 1000);
            var errorResult = this._buildFailureResult('Exception: ' + e);
            this._logGeneration(storyId, errorResult, duration3, null);
            return errorResult;
        }
    },
    
    /**
     * Helper to build a standard failure result object
     */
    _buildFailureResult: function(message) {
        return {
            success: false,
            message: message,
            totalGenerated: 0,
            successCount: 0,
            failureCount: 0,
            createdTests: []
        };
    },
    
    /**
     * Retrieve user story from database
     */
    _getUserStory: function(storyId) {
        try {
            var storyGr = new GlideRecord('rm_story');
            
            if (!storyGr.get(storyId)) {
                return { success: false, message: 'User story not found: ' + storyId, data: null };
            }
            
            var story = {
                sys_id: storyGr.getUniqueValue(),
                number: storyGr.getValue('number'),
                short_description: storyGr.getValue('short_description'),
                description: storyGr.getValue('description'),
                acceptance_criteria: storyGr.getValue('acceptance_criteria'),
                priority: storyGr.getDisplayValue('priority'),
                state: storyGr.getDisplayValue('state'),
                application: storyGr.getValue('application'),
                application_name: storyGr.getDisplayValue('application')
            };
            
            gs.debug(this.LOG_PREFIX + ': Retrieved story: ' + story.number);
            return { success: true, data: story, message: 'Story retrieved successfully' };
            
        } catch (e) {
            gs.error(this.LOG_PREFIX + '._getUserStory: ' + e);
            return { success: false, message: 'Error retrieving story: ' + e, data: null };
        }
    },
    
    /**
     * Build AI prompts from user story data
     */
    _buildPrompt: function(story) {
        try {
            var storyNumber = story.number || 'N/A';
            var storyTitle = story.short_description || 'Untitled Story';
            var storyDescription = this._cleanText(story.description || 'No description provided');
            var acceptanceCriteria = this._cleanText(story.acceptance_criteria || 'No acceptance criteria provided');
            var application = story.application_name || 'Not specified';
            var priority = story.priority || 'Medium';
            
            var systemPrompt = 
                "You are an expert Quality Assurance test case generator for ServiceNow Test Management 2.0. " +
                "Your role is to create comprehensive, detailed, and professional test cases from user stories. " +
                "\n\n**YOUR EXPERTISE:**\n" +
                "- Deep knowledge of software testing methodologies (positive, negative, edge cases, boundary conditions)\n" +
                "- Understanding of user story format and acceptance criteria\n" +
                "- Expertise in test case structure and best practices\n" +
                "- Ability to identify all critical test scenarios\n\n" +
                "**YOUR OUTPUT:**\n" +
                "- Must be valid JSON only (no markdown, no code blocks, no explanations)\n" +
                "- Must follow the exact structure provided\n" +
                "- Must include diverse test scenarios (happy path, negative, edge cases)\n" +
                "- Test steps must be clear, actionable, and use imperative verbs\n" +
                "- Expected results must be specific and measurable\n\n" +
